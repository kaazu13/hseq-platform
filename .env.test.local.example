# Copy this file to .env.test.local and fill in the values `supabase start`
# prints to your terminal (under "API URL", "anon key", "service_role key").
# Never commit .env.test.local — it is git-ignored the same way .env.local is.
#
# These MUST be your LOCAL Supabase instance's values, never the remote
# project's. tests/db/helpers.ts and tests/integration/helpers.ts both
# refuse to run at all against any non-loopback host — see each file's
# header comment — but keeping local-only values here is still the point:
# there is no legitimate reason for these test commands to ever hold a
# remote credential.
#
# Run `supabase start` first (requires Docker) to get real values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Only needed if your local Postgres port differs from the Supabase CLI
# default (54322, per supabase/config.toml's [db] port). Optional — falls
# back to postgresql://postgres:postgres@127.0.0.1:54322/postgres.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
